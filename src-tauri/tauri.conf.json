{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CSVScope",
  "version": "0.1.1",
  "identifier": "io.github.tongjixyz.csvscope",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-build.ps1",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "CSVScope", "width": 1440, "height": 920, "minWidth": 960, "minHeight": 640, "dragDropEnabled": true }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": { "../runtime/*.dll": "" },
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}
